DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taxwise"
# Generate a random secret of at least 32 bytes. Never reuse the example text.
JWT_SECRET=""
APP_URL="http://localhost:3000"
ADMIN_EMAILS=""
# Optional. Gemini 2.5 Flash suggestions; rules used when absent/unavailable.
GEMINI_API_KEY=""
# Optional. Main demo + six telemetry accounts; skipped when unset.
SEED_DEMO_PASSWORD=""
# Explicitly replace only demo@taxwise.example's ledger/profile; otherwise existing data is skipped.
SEED_RESET_DEMO="false"
# Optional, independent admin account; skipped when unset or already present.
SEED_ADMIN_PASSWORD=""
# Optional local HTTP smoke test origin; must match the running server's APP_URL.
SMOKE_APP_URL="http://localhost:3000"
# Optional direct Neon URL for Prisma CLI migrations; app queries use DATABASE_URL.
DATABASE_URL_UNPOOLED=""
# Random bearer secret for the daily Vercel Cron job (generate separately from JWT_SECRET).
CRON_SECRET=""
