{
  "name": "taxwise-freelance",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "build:local": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "smoke": "node scripts/smoke.mjs",
    "verify:bundle": "node scripts/verify-server-bundle.mjs",
    "lint:security": "eslint --config eslint.security.config.mjs src scripts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcrypt": "^6",
    "dotenv": "^17",
    "jose": "^6",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "pdfkit": "^0.20.2",
    "pg": "^8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcrypt": "^6",
    "@types/node": "^24",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-security": "^4.2.0",
    "jiti": "^2.7.0",
    "pdfjs-dist": "^6.4.299",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.12"
  }
}
